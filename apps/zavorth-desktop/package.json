{
  "name": "@zavorth/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Zavorth",
  "main": "electron/main.cjs",
  "description": "Zavorth Desktop native shell for the local runtime.",
  "scripts": {
    "dev": "node scripts/desktop-dev.mjs",
    "dev:static": "npm run build --silent && npx --yes --package electron electron electron/main.cjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "check": "vite build --mode production",
    "check:shell": "node scripts/desktop-shell-check.mjs",
    "check:quality": "node scripts/desktop-quality-check.mjs",
    "check:electron": "node scripts/desktop-electron-smoke.mjs",
    "check:visual": "node scripts/desktop-visual-check.mjs",
    "check:a11y": "node scripts/desktop-a11y-check.mjs",
    "check:all": "npm run typecheck && npm run check && npm run check:shell && npm run check:quality && npm run test",
    "check:ci": "npm run check:all && npm run check:visual && npm run check:a11y",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron-unit": "node --test electron/*.test.cjs",
    "test:all": "npm run test && npm run test:electron-unit",
    "package:dir": "npm run build --silent && npx --yes --package electron-builder electron-builder --dir",
    "package:release": "npm run build --silent && npx --yes --package electron-builder electron-builder --publish never",
    "package:publish": "npm run build --silent && npx --yes --package electron-builder electron-builder --publish always",
    "signing:status": "node electron/desktop-update-signing.cjs",
    "production:readiness": "node scripts/desktop-production-readiness.mjs",
    "production:readiness:strict": "node scripts/desktop-production-readiness.mjs --strict",
    "icons:generate": "node scripts/generate-app-icons.mjs"
  },
  "dependencies": {
    "@nanostores/react": "^1.1.0",
    "nanostores": "^1.1.0",
    "@tabler/icons-react": "^3.44.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^3.18.0",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "nanostores": "^1.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "^5.7.0",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "app.zavorth.desktop",
    "productName": "Zavorth",
    "artifactName": "Zavorth-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "../../dist-standalone",
        "to": "dist-standalone",
        "filter": [
          "zavorth.exe",
          "zavorth",
          "native/**/*"
        ]
      }
    ],
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "build/icon.png",
      "build/icon.ico",
      "public/icon.png"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zavorth",
        "repo": "zavorth",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "signExecutable": false,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
