<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability
        android:name="custom.actions.intent.ASK_ZAVORTH"
        app:queryPatterns="@array/ask_zavorth_query_patterns">
        <intent
            android:action="dev.zavorth.companion.action.ASK_ZAVORTH"
            android:targetPackage="dev.zavorth.companion"
            android:targetClass="dev.zavorth.companion.MainActivity">
            <parameter
                android:name="prompt"
                android:key="prompt"
                android:mimeType="https://schema.org/Text"
                android:required="true" />
        </intent>
    </capability>
</shortcuts>
