{
  "version": "zavorth.profile/1",
  "id": "developer",
  "label": "Developer workspace",
  "description": "Technical local development profile with deep planning, workspace reads exposed and mutating tools routed through approval.",
  "tags": ["development", "local"],
  "cognitive": {
    "responseStyle": "technical-clear",
    "autonomy": "governed",
    "languagePolicy": "match-user",
    "planningDepth": "deep",
    "providerNativeTools": ["google_search", "code_execution"]
  },
  "runtime": {
    "trustMode": "balanced",
    "approvalMode": "risk-based",
    "sandboxMode": "required",
    "maxToolRounds": 12,
    "maxDeniedAttempts": 3
  },
  "capabilities": {
    "allow": ["read_file", "list_directory", "get_datetime", "web_search", "zavorth_action"],
    "requireApproval": ["workspace.write", "shell.exec", "write_file", "create_file", "remote_shell", "run_sandbox_code"],
    "providerNativeTools": ["google_search", "code_execution"]
  },
  "surfaces": {
    "default": "cli",
    "allowed": ["cli", "zavorthControl", "api", "telegram"]
  },
  "memory": {
    "mode": "episodic",
    "learning": "approved-only"
  },
  "improvement": {
    "mode": "quiet-staging",
    "silent": ["telemetry", "ranking", "metadata", "candidate", "staging_diff", "sandbox_validation"],
    "notify": ["draft_skill", "low_risk_archive"],
    "requireApproval": ["apply", "policy", "provider", "channel", "secret", "external_send", "host_mutation"],
    "maxSilentRisk": "medium",
    "interruptMode": "daily-digest"
  }
}
