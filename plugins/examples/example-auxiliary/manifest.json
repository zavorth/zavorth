      "intent": "diagnostics.ephemera.status",
      "label": "Ephemera Status",
      "summary": "Report idle auxiliary status.",
      "artifactKinds": [],
      "command": {
        "name": "example_auxiliary_status",
        "aliases": [],
        "usage": null
      }
    }
  ],
  "permissions": [],
  "entrypoint": {
    "module": "./index.js",
    "exportName": "register",
    "runtime": "node"
  },
  "lifecycle": {
    "actions": ["install", "enable", "disable", "uninstall", "invoke", "doctor"],
