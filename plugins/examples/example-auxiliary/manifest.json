{
  "schemaVersion": "zavorth.plugin-os.v1",
  "id": "example-auxiliary",
  "label": "Example Auxiliary",
  "version": "0.1.0",
  "moduleKind": "diagnostics",
  "summary": "Diagnostics-style status capability example.",
