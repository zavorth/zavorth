  "tags": ["diagnostics", "example", "auxiliary"],
  "source": {
    "kind": "local",
    "locator": "bundled://examples/example-auxiliary",
    "digest": null,
    "trusted": false
  },
  "compatibility": {
    "zavorthVersion": ">=1.1.0",
    "pluginApiVersion": "zavorth.plugin-os.v1"
  },
