{
  "schemaVersion": "zavorth.plugin-os.v1",
  "id": "example-channel",
  "label": "Example Channel",
  "version": "0.1.0",
  "moduleKind": "channel",
  "summary": "Minimal channel adapter template for Plugin OS.",
  "description": "Bundled example channel plugin using bindChannel.",
  "tags": ["channel", "example"],
  "source": {
    "kind": "local",
    "locator": "bundled://examples/example-channel",
    "digest": null,
    "trusted": false
  },
  "compatibility": {
    "zavorthVersion": ">=1.1.0",
    "pluginApiVersion": "zavorth.plugin-os.v1"
  },
  "capabilities": [
    {
      "id": "channel.send",
      "intent": "channel.send",
      "label": "Channel Send",
      "summary": "Template channel send.",
      "artifactKinds": [],
      "command": {
        "name": "example_channel_send",
        "aliases": [],
        "usage": null
      }
    }
  ],
  "permissions": [
    {
      "kind": "network.external",
      "scope": "runtime",
      "reason": "Channel adapters may send outbound messages when approved.",
      "required": false
    }
  ],
  "entrypoint": {
    "module": "./index.js",
    "exportName": "register",
    "runtime": "node"
  },
  "lifecycle": {
    "actions": ["install", "enable", "disable", "uninstall", "invoke", "doctor"],
    "defaultAction": "invoke"
  },
  "policy": {
    "defaultTrust": "review",
    "requiresApproval": true,
    "allowNetworkByDefault": false,
    "allowFilesystemWriteByDefault": false,
    "allowProcessSpawnByDefault": false,
    "sandboxProfile": "restricted"
  },
  "artifactKinds": [],
  "receiptKinds": []
}
