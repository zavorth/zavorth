{
  "schemaVersion": "zavorth.plugin-os.v1",
  "id": "example-search",
  "label": "Example Search",
  "version": "0.1.0",
  "moduleKind": "search",
  "summary": "Minimal search capability stub for Plugin OS.",
  "description": "Bundled example search plugin. Soft-fail register; returns empty results, no network.",
  "tags": ["search", "example"],
  "source": {
    "kind": "local",
    "locator": "bundled://examples/example-search",
    "digest": null,
    "trusted": false
  },
  "compatibility": {
    "zavorthVersion": ">=1.1.0",
    "pluginApiVersion": "zavorth.plugin-os.v1"
  },
  "capabilities": [
    {
      "id": "search.query",
      "intent": "search.query",
      "label": "Search Query",
      "summary": "Stub search query (no external calls).",
      "artifactKinds": [],
      "command": {
        "name": "example_search_query",
        "aliases": [],
        "usage": "{ query|q }"
      }
    }
  ],
  "permissions": [
    {
      "kind": "network.external",
      "scope": "external",
      "reason": "Search plugins may call external search APIs when approved.",
      "required": false
    }
  ],
  "entrypoint": {
    "module": "./index.js",
    "exportName": "register",
    "runtime": "node"
  },
  "lifecycle": {
    "actions": ["install", "enable", "disable", "uninstall", "invoke", "doctor"],
    "defaultAction": "invoke"
  },
  "policy": {
    "defaultTrust": "review",
    "requiresApproval": false,
    "allowNetworkByDefault": false,
    "allowFilesystemWriteByDefault": false,
    "allowProcessSpawnByDefault": false,
    "sandboxProfile": "restricted"
  },
  "artifactKinds": [],
  "receiptKinds": []
}
