{
  "schemaVersion": "zavorth.plugin-os.v1",
  "id": "security-guidance",
  "label": "Security Guidance",
  "version": "1.0.0",
  "moduleKind": "diagnostics",
  "summary": "Non-blocking scan for dangerous code patterns after tool writes.",
  "description": "First-party diagnostics plugin that observes tool.after_execute and exposes security.scan for text pattern checks. Never throws; warnings only.",
  "tags": ["security", "scan", "diagnostics", "hooks", "guidance"],
  "source": {
    "kind": "local",
    "locator": "bundled://security-guidance",
    "digest": null,
    "trusted": false
  },
  "compatibility": {
    "zavorthVersion": ">=1.1.0",
    "pluginApiVersion": "zavorth.plugin-os.v1"
  },
  "capabilities": [
    {
      "id": "security.scan",
      "intent": "security.scan",
      "label": "Security Scan",
      "summary": "Scan text for dangerous patterns and return warnings.",
      "artifactKinds": ["security.warning"],
      "command": {
        "name": "security_scan",
        "aliases": ["scan_security"],
        "usage": "{ text }"
      }
    }
  ],
  "permissions": [
    {
      "kind": "filesystem.read",
      "scope": "workspace",
      "reason": "Read security warning ledger.",
      "required": false
    },
    {
      "kind": "filesystem.write",
      "scope": "workspace",
      "reason": "Append security warning ledger entries.",
      "required": false
    },
    {
      "kind": "artifact.write",
      "scope": "workspace",
      "reason": "Write security warning artifacts.",
      "required": false
    }
  ],
  "entrypoint": {
    "module": "./index.js",
    "exportName": "register",
    "runtime": "node"
  },
  "lifecycle": {
    "actions": ["install", "enable", "disable", "uninstall", "invoke", "doctor"],
    "defaultAction": "invoke"
  },
  "policy": {
    "defaultTrust": "review",
    "requiresApproval": false,
    "allowNetworkByDefault": false,
    "allowFilesystemWriteByDefault": false,
    "allowProcessSpawnByDefault": false,
    "sandboxProfile": "restricted"
  },
  "artifactKinds": ["security.warning"],
  "receiptKinds": ["security-guidance.receipt"]
}
