{
  "schemaVersion": "zavorth.plugin-os.v1",
  "id": "provider-openai-compatible",
  "label": "OpenAI-Compatible Provider",
  "version": "1.0.0",
  "moduleKind": "provider",
  "summary": "Soft-fail OpenAI-compatible chat completions (OpenAI, OpenRouter, local gateways).",
  "description": "Provider pack. Uses OPENAI_API_KEY / OPENAI_BASE_URL. Never returns secret values. Core providers remain authoritative when configured.",
  "tags": ["provider", "openai", "openrouter", "llm", "complete"],
  "source": {
    "kind": "local",
    "locator": "bundled://provider-openai-compatible",
    "digest": null,
    "trusted": false
  },
  "compatibility": {
    "zavorthVersion": ">=1.1.0",
    "pluginApiVersion": "zavorth.plugin-os.v1"
  },
  "capabilities": [
    {
      "id": "provider.openai_compatible.status",
      "intent": "provider.openai_compatible.status",
      "label": "Status",
      "summary": "Report key/base URL presence (no secrets).",
      "artifactKinds": [],
      "command": { "name": "provider_openai_status", "aliases": [], "usage": "{}" }
    },
    {
      "id": "provider.openai_compatible.complete",
      "intent": "provider.openai_compatible.complete",
      "label": "Complete",
      "summary": "Soft chat completion via OpenAI-compatible HTTP API.",
      "artifactKinds": [],
      "command": { "name": "provider_openai_complete", "aliases": [], "usage": "{ prompt, model? }" }
    }
  ],
  "permissions": [
    {
      "kind": "network.external",
      "scope": "external",
      "reason": "Call OpenAI-compatible chat completions endpoint.",
      "required": false
    },
    {
      "kind": "provider.call",
      "scope": "external",
      "reason": "Invoke LLM completion.",
      "required": false
    },
    {
      "kind": "secret.read",
      "scope": "local",
      "reason": "Read whether OPENAI_API_KEY is set (not the value).",
      "required": false
    }
  ],
  "entrypoint": {
    "module": "./index.js",
    "exportName": "register",
    "runtime": "node"
  },
  "lifecycle": {
    "actions": ["install", "enable", "disable", "uninstall", "invoke", "doctor"],
    "defaultAction": "invoke"
  },
  "policy": {
    "defaultTrust": "review",
    "requiresApproval": true,
    "allowNetworkByDefault": false,
    "allowFilesystemWriteByDefault": false,
    "allowProcessSpawnByDefault": false,
    "sandboxProfile": "restricted"
  },
  "artifactKinds": [],
  "receiptKinds": ["provider-openai-compatible.receipt"]
}
