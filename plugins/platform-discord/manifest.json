{
  "schemaVersion": "zavorth.plugin-os.v1",
  "id": "platform-discord",
  "label": "Discord Platform",
  "version": "1.0.0",
  "moduleKind": "channel",
  "summary": "Soft-fail Discord Bot API channel for status and outbound send.",
  "description": "Wave 2 platform pack. Uses DISCORD_BOT_TOKEN presence only (never the value). Sends via discord.com REST when network permission is granted.",
  "tags": ["platform", "discord", "channel", "wave2", "messaging"],
  "source": {
    "kind": "local",
    "locator": "bundled://platform-discord",
    "digest": null,
    "trusted": false
  },
  "compatibility": {
    "zavorthVersion": ">=1.1.0",
    "pluginApiVersion": "zavorth.plugin-os.v1"
  },
  "capabilities": [
    {
      "id": "platform.discord.status",
      "intent": "platform.discord.status",
      "label": "Status",
      "summary": "Report Discord bot token presence (never the value).",
      "artifactKinds": [],
      "command": { "name": "platform_discord_status", "aliases": [], "usage": "{}" }
    },
    {
      "id": "platform.discord.send",
      "intent": "platform.discord.send",
      "label": "Send",
      "summary": "Soft send a Discord channel message via Bot REST API.",
      "artifactKinds": [],
      "command": {
        "name": "platform_discord_send",
        "aliases": [],
        "usage": "{ channelId, content|text|message }"
      }
    }
  ],
  "permissions": [
    {
      "kind": "network.external",
      "scope": "external",
      "reason": "Call Discord REST API over HTTPS.",
      "required": false
    },
    {
      "kind": "channel.send",
      "scope": "external",
      "reason": "Deliver outbound Discord messages.",
      "required": false
    },
    {
      "kind": "secret.read",
      "scope": "local",
      "reason": "Detect DISCORD_BOT_TOKEN presence.",
      "required": false
    }
  ],
  "entrypoint": {
    "module": "./index.js",
    "exportName": "register",
    "runtime": "node"
  },
  "lifecycle": {
    "actions": ["install", "enable", "disable", "uninstall", "invoke", "doctor"],
    "defaultAction": "invoke"
  },
  "policy": {
    "defaultTrust": "review",
    "requiresApproval": true,
    "allowNetworkByDefault": false,
    "allowFilesystemWriteByDefault": false,
    "allowProcessSpawnByDefault": false,
    "sandboxProfile": "restricted"
  },
  "artifactKinds": [],
  "receiptKinds": ["platform-discord.receipt"]
}
