{
 "schemaVersion": "zavorth.plugin-os.v1",
 "id": "demo-showcase",
 "label": "Demo Showcase",
 "version": "1.0.0",
 "moduleKind": "diagnostics",
 "summary": "showcase exercising specialized register_* APIs in one soft-fail package.",
 "description": "Lifestyle & demos pack. Binds demo.showcase.* capabilities and soft-calls specialized registrars (skill, cli, auxiliary, web search, browser, media, secret, auth, context, slack, middleware) when present. No real network. Suitable for demos and surface-parity tables.",
 "tags": ["demo", "showcase", "surface-parity", "lifestyle"],
 "source": {
 "kind": "local",
 "locator": "bundled://demo-showcase",
 "digest": null,
 "trusted": false
 },
 "compatibility": {
 "zavorthVersion": ">=1.1.0",
 "pluginApiVersion": "zavorth.plugin-os.v1"
 },
 "capabilities": [
 {
 "id": "demo.showcase.status",
 "intent": "demo.showcase.status",
 "label": "Showcase Status",
 "summary": "Report which specialized registrars were available at register time plus pack tag s.",
 "artifactKinds": [],
 "command": {
 "name": "demo_showcase_status",
 "aliases": ["showcase_status"],
 "usage": "{}"
 }
 },
 {
 "id": "demo.showcase.ping",
 "intent": "demo.showcase.ping",
 "label": "Showcase Ping",
 "summary": "Echo a message with pack tag.",
 "artifactKinds": [],
 "command": {
 "name": "demo_showcase_ping",
 "aliases": ["showcase_ping"],
 "usage": "{ message? }"
 }
 },
 {
 "id": "demo.showcase.skill",
 "intent": "demo.showcase.skill",
 "label": "Showcase Skill",
 "summary": "Soft skill demo handler (registerSkill when available).",
 "artifactKinds": [],
 "command": {
 "name": "demo_showcase_skill",
 "aliases": [],
 "usage": "{ input? }"
 }
 },
 {
 "id": "demo.showcase.cli",
 "intent": "demo.showcase.cli",
 "label": "Showcase CLI",
 "summary": "Soft CLI command demo (registerCliCommand when available).",
 "artifactKinds": [],
 "command": {
 "name": "demo_showcase_cli",
 "aliases": [],
 "usage": "{ args? }"
 }
 },
 {
 "id": "demo.showcase.auxiliary",
 "intent": "demo.showcase.auxiliary",
