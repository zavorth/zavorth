{
  "schemaVersion": "zavorth.plugin-os.v1",
  "id": "provider-local-llama",
  "label": "Local Llama Provider",
  "version": "1.0.0",
  "moduleKind": "provider",
  "summary": "Soft-fail local OpenAI-compatible LLM (llama.cpp, vLLM, etc.).",
  "description": "First-party provider pack. Uses LOCAL_LLM_BASE_URL (and optional LOCAL_LLM_API_KEY). network.local permission.",
  "tags": ["provider", "local", "llama", "llm", "complete"],
  "source": {
    "kind": "local",
    "locator": "bundled://provider-local-llama",
    "digest": null,
    "trusted": false
  },
  "compatibility": {
    "zavorthVersion": ">=1.1.0",
    "pluginApiVersion": "zavorth.plugin-os.v1"
  },
  "capabilities": [
    {
      "id": "provider.local_llama.status",
      "intent": "provider.local_llama.status",
      "label": "Status",
      "summary": "Report Local Llama (OpenAI-compat) readiness (no secrets).",
      "artifactKinds": [],
      "command": {
        "name": "provider_local_llama_status",
        "aliases": [],
        "usage": "{}"
      }
    },
    {
      "id": "provider.local_llama.complete",
      "intent": "provider.local_llama.complete",
      "label": "Complete",
      "summary": "Soft chat completion via Local Llama (OpenAI-compat).",
      "artifactKinds": [],
      "command": {
        "name": "provider_local_llama_complete",
        "aliases": [],
        "usage": "{ prompt, model? }"
      }
    }
  ],
  "permissions": [
    {
      "kind": "network.local",
      "scope": "local",
      "reason": "Call Local Llama (OpenAI-compat) chat completions endpoint.",
      "required": false
    },
    {
      "kind": "provider.call",
      "scope": "local",
      "reason": "Invoke LLM completion.",
      "required": false
    },
    {
      "kind": "secret.read",
      "scope": "local",
      "reason": "Detect LOCAL_LLM_API_KEY presence (not the value).",
      "required": false
    }
  ],
  "entrypoint": {
    "module": "./index.js",
    "exportName": "register",
    "runtime": "node"
  },
  "lifecycle": {
    "actions": ["install", "enable", "disable", "uninstall", "invoke", "doctor"],
    "defaultAction": "invoke"
  },
  "policy": {
    "defaultTrust": "review",
    "requiresApproval": true,
    "allowNetworkByDefault": false,
    "allowFilesystemWriteByDefault": false,
    "allowProcessSpawnByDefault": false,
    "sandboxProfile": "restricted"
  },
  "artifactKinds": [],
  "receiptKinds": ["provider-local-llama.receipt"]
}
