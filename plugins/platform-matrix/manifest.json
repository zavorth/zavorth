{
  "schemaVersion": "zavorth.plugin-os.v1",
  "id": "platform-matrix",
  "label": "Matrix Platform",
  "version": "1.0.0",
  "moduleKind": "channel",
  "summary": "Soft-fail Matrix CS API channel for status and outbound send.",
  "description": "First-party channel pack. Uses MATRIX_HOMESERVER (or MATRIX_BASE_URL) + MATRIX_ACCESS_TOKEN presence only (never values). Soft send via Client-Server API when network permission is granted.",
  "tags": ["platform", "matrix", "channel", "messaging"],
  "source": {
    "kind": "local",
    "locator": "bundled://platform-matrix",
    "digest": null,
    "trusted": false
  },
  "compatibility": {
    "zavorthVersion": ">=1.1.0",
    "pluginApiVersion": "zavorth.plugin-os.v1"
  },
  "capabilities": [
    {
      "id": "platform.matrix.status",
      "intent": "platform.matrix.status",
      "label": "Status",
      "summary": "Report Matrix homeserver + access token presence (never values).",
      "artifactKinds": [],
      "command": { "name": "platform_matrix_status", "aliases": [], "usage": "{}" }
    },
    {
      "id": "platform.matrix.send",
      "intent": "platform.matrix.send",
      "label": "Send",
      "summary": "Soft send a Matrix room message via Client-Server API.",
      "artifactKinds": [],
      "command": {
        "name": "platform_matrix_send",
        "aliases": [],
        "usage": "{ roomId|room_id, text|message|body }"
      }
    }
  ],
  "permissions": [
    {
      "kind": "network.external",
      "scope": "external",
      "reason": "Call Matrix Client-Server API over HTTPS.",
      "required": false
    },
    {
      "kind": "channel.send",
      "scope": "external",
      "reason": "Deliver outbound Matrix messages.",
      "required": false
    },
    {
      "kind": "secret.read",
      "scope": "local",
      "reason": "Detect MATRIX_HOMESERVER / MATRIX_ACCESS_TOKEN presence.",
      "required": false
    }
  ],
  "entrypoint": {
    "module": "./index.js",
    "exportName": "register",
    "runtime": "node"
  },
  "lifecycle": {
    "actions": ["install", "enable", "disable", "uninstall", "invoke", "doctor"],
    "defaultAction": "invoke"
  },
  "policy": {
    "defaultTrust": "review",
    "requiresApproval": true,
    "allowNetworkByDefault": false,
    "allowFilesystemWriteByDefault": false,
    "allowProcessSpawnByDefault": false,
    "sandboxProfile": "restricted"
  },
  "artifactKinds": [],
  "receiptKinds": ["platform-matrix.receipt"]
}
