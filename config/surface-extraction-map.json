{
  "phase": 2,
  "policy": "preserve-agent-capabilities",
  "officialRepositoryFocus": [
    "runtime",
    "terminal",
    "api",
    "operational adapters"
  ],
  "clients": [
    {
      "id": "vercel-web",
      "path": "../zavorth-web",
      "kind": "static-client",
      "status": "externalized-client",
      "targetRepository": "zavorth-web",
      "ownerAfterExtraction": "external-client",
      "consumes": [
        "GET /api/auth/status",
        "POST /api/auth/validate",
        "GET /api/web/session",
        "GET /api/web/state",
        "GET /api/web/catalog",
        "GET /api/web/events",
        "POST /api/web/chat/send",
        "POST /api/web/permissions/approve",
        "POST /api/web/permissions/reject",
        "POST /api/web/tasks/approve",
        "POST /api/web/tasks/reject",
        "GET /api/web/file-preview",
        "GET /api/web/host/access-manifest",
        "GET /api/web/host/install-journey",
        "GET /api/web/host/official-remote-access",
        "POST /api/web/host/official-remote-access/actions",
        "GET /api/web/operations/product-observability"
      ],
      "currentCouplings": [
        "scripts/prepare-remote-surfaces.mjs",
        "scripts/publish-remote.mjs",
        "remote-dist output"
      ],
      "primaryRisk": "api-and-sse-contract-drift"
    },
    {
      "id": "zavorth-ui",
      "path": "../zavorth-ui-sandbox",
      "kind": "react-sandbox",
      "status": "externalized-sandbox",
      "targetRepository": "zavorth-ui-sandbox",
      "ownerAfterExtraction": "experimental-client",
      "consumes": [
        "GET /api/auth/status",
        "POST /api/auth/validate",
        "GET /api/web/session",
        "GET /api/web/state",
        "POST /api/web/chat/send",
        "GET /api/web/tasks",
        "GET /api/web/permissions",
        "POST /api/web/permissions/approve",
        "POST /api/web/permissions/reject",
        "POST /api/web/tasks/approve",
        "POST /api/web/tasks/reject",
        "GET /api/web/host/status",
        "GET /api/web/host/readiness",
        "GET /api/web/events"
      ],
      "currentCouplings": [
        "zavorth-ui/src/api.ts",
        "local vite dev workflow"
      ],
      "primaryRisk": "experimental-ui-with-weak-contract"
    },
    {
      "id": "site",
      "path": "../zavorth-docs",
      "kind": "public-docs-site",
      "status": "externalized-docs-site",
      "targetRepository": "zavorth-docs",
      "ownerAfterExtraction": "docs-client",
      "consumes": [
        "docs markdown snapshot"
      ],
      "currentCouplings": [
        "root wrappers docs:site:*",
        "zavorth-docs/scripts/sync-docs.mjs",
        "docs markdown snapshot"
      ],
      "primaryRisk": "doc-source-duplication"
    }
  ],
  "mustRemainInOfficialRepo": [
    "src/services/WebAppService.ts",
    "src/services/SharedSurfaceParityService.ts",
    "auth web",
    "session canonical state",
    "continuity and replay",
    "file preview",
    "official remote access",
    "runtime HTTP contracts",
    "runtime SSE contracts"
  ]
}
