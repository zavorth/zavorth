{
  "schemaVersion": "zavorth.plugin-os-wave-packs.v1",
  "packs": [
    {
      "id": "daily-ops",
      "label": "Daily Ops",
      "wave": "baseline",
      "intents": ["plan tasks", "ship pr", "ci status", "doctor", "secrets scan", "recall", "notify"],
      "pluginIds": [
        "workspace-doctor",
        "task-board",
        "pr-ship",
        "ci-watch",
        "secrets-guardian",
        "session-recall",
        "notify-outbox"
      ],
      "enableHint": "Enable the Daily Ops pack for ship/plan/CI loops."
    },
    {
      "id": "providers",
      "label": "Provider pack (W1)",
      "wave": "W1",
      "intents": ["llm", "openai", "anthropic", "grok", "gemini", "complete", "chat model"],
      "pluginIds": [
        "provider-status",
        "provider-openai-compatible",
        "provider-anthropic",
        "provider-xai",
        "provider-gemini"
      ],
      "enableHint": "Enable provider plugins (needs API keys)."
    },
    {
      "id": "platforms",
      "label": "Platform pack (W2)",
      "wave": "W2",
      "intents": ["telegram", "discord", "whatsapp", "webhook message", "send message"],
      "pluginIds": [
        "platform-telegram",
        "platform-discord",
        "platform-whatsapp",
        "platform-webhook",
        "notify-outbox"
      ],
      "enableHint": "Enable messaging platform plugins."
    },
    {
      "id": "memory",
      "label": "Memory pack (W3)",
      "wave": "W3",
      "intents": ["remember", "memory", "journal", "vector search", "mem0"],
      "pluginIds": [
        "memory-local",
        "memory-file-journal",
        "memory-vector-local",
        "memory-honcho",
        "memory-mem0",
        "session-recall"
      ],
      "enableHint": "Enable memory backends."
    },
    {
      "id": "media",
      "label": "Media pack (W4)",
      "wave": "W4",
      "intents": ["generate image", "vision", "tts", "transcribe", "video gen", "speech"],
      "pluginIds": [
        "media-image-gen",
        "media-vision",
        "media-tts",
        "media-transcription",
        "media-video-gen"
      ],
      "enableHint": "Enable multimodal media plugins."
    },
    {
      "id": "browser-search",
      "label": "Browser & search (W5)",
      "wave": "W5",
      "intents": ["web search", "browse", "scrape", "firecrawl", "exa", "cdp", "playwright"],
      "pluginIds": [
        "web-search",
        "browser-playwright",
        "browser-cdp",
        "search-exa",
        "search-firecrawl"
      ],
      "enableHint": "Enable browser and search backends."
    },
    {
      "id": "trust",
      "label": "Trust fabric (W6)",
      "wave": "W6",
      "intents": ["secret", "auth", "rate limit", "context engine", "dashboard login"],
      "pluginIds": [
        "secret-source-env",
        "secret-source-file",
        "dashboard-auth-basic",
        "dashboard-auth-token",
        "context-engine-bridge",
        "middleware-rate-limit",
        "secrets-guardian",
        "security-guidance"
      ],
      "enableHint": "Enable trust fabric plugins."
    },
    {
      "id": "lifestyle",
      "label": "Lifestyle & demos (W7)",
      "wave": "W7",
      "intents": ["spotify", "music", "demo showcase", "surface parity"],
      "pluginIds": ["spotify-soft", "demo-showcase"],
      "enableHint": "Enable optional lifestyle/demo plugins."
    },
    {
      "id": "ecosystem",
      "label": "Ecosystem (W8)",
      "wave": "W8",
      "intents": ["create plugin", "marketplace", "atlas", "publish sdk", "third party plugin"],
      "pluginIds": ["plugin-router-ai", "selfmod-plugin-forge", "mcp-bridge"],
      "enableHint": "Use create-zavorth-plugin, atlas docs, and remote marketplace URL."
    }
  ]
}
