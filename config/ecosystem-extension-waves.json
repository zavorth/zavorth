{
  "schemaVersion": "zavorth.ecosystem-extension-packs.v1",
  "goal": "Brand-agnostic skill/plugin/external-agent extensibility: any URI/path/user catalog, optional LLM rank only, no third-party product names in runtime.",
  "doc": "docs/product/ecosystem-extension-waves.md",
  "principles": [
    "Shape-based parsers only (SKILL.md, package layout, opaque guidance)",
    "User-configured catalogs and trusted hosts — no hardcoded foreign hubs",
    "Free-text never auto-enables skills/plugins; consent + structured control",
    "LLM ranks closed candidate lists only when user opts in",
    "Every install/import/apply leaves a receipt"
  ],
  "mvpConsumer": [
    "contracts-skill-ir",
    "install-binds",
    "search-index",
    "remote-catalogs",
    "capability-miss"
  ],
  "mvpAuthorGrowth": [
    "contracts-skill-ir",
    "install-binds",
    "search-index",
    "remote-catalogs",
    "capability-miss",
    "promote",
    "plugin-scaffold"
  ],
  "mvpExternalAttach": [
    "contracts-skill-ir",
    "install-binds",
    "external-import"
  ],
