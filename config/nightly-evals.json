{
  "schemaVersion": "nightly-evals.v1",
  "description": "Automated nightly evaluation pipeline for agent quality",
  "enabled": true,
  "schedule": {
    "cron": "0 2 * * *",
    "timezone": "America/Sao_Paulo",
    "maxDurationMinutes": 60
  },
  "evaluationSets": {
    "golden": {
      "description": "Human-verified correct actions",
      "path": "data/eval-golden.json",
      "minSize": 50,
      "refreshIntervalDays": 30
    },
    "silver": {
      "description": "Programmatically generated with confidence calibration",
      "path": "data/eval-silver.json",
      "minSize": 200,
      "refreshIntervalDays": 7
    },
    "bronze": {
      "description": "Heuristically generated by autolabelers",
      "path": "data/eval-bronze.json",
      "minSize": 500,
      "refreshIntervalDays": 1
    }
  },
  "metrics": {
    "precision": {
      "description": "Of actions marked correct, how many actually are?",
      "target": 0.95
    },
    "recall": {
      "description": "Of actual correct actions, how many did agent find?",
      "target": 0.90
    },
    "f1Score": {
      "description": "Harmonic mean of precision and recall",
      "target": 0.92
    },
    "latencyP95": {
      "description": "95th percentile response time",
      "targetMs": 5000
    }
  },
  "actions": {
    "onPass": {
      "logToReceipt": true,
      "updatePromotionEligibility": true,
      "notifyChannel": false
    },
    "onFail": {
      "logToReceipt": true,
      "createBugReport": true,
      "alertUser": true,
      "demoteLevel": false
    },
    "onRegression": {
      "blockRelease": true,
      "alertUser": true,
      "createIncident": true
    }
  },
  "reporting": {
    "generateHtmlReport": true,
    "reportPath": "data/eval-reports/",
    "retainReportsDays": 30,
    "notifyOnComplete": true
  }
}
