# ============================================================
# 🐍 ZAVORTH — Arquivo de Configuração (Template)
# ============================================================
# Copie este arquivo para `.env` e preencha com suas chaves.
# Ou rode `npm run setup` para configurar o runtime base interativamente.
# Se quiser ligar canais opcionais depois, use `npm run setup:channels`.
# O wizard cobre Telegram, Discord, Slack, WhatsApp, Signal, iMessage, Teams e Email.
# ============================================================

# === Capability Autopilot v1.1 alpha ===
# Preview desligado por padrao. Ligue apenas em sessao alpha/operator.
# Quando habilitado, o Zavorth pode diagnosticar capabilities ausentes, montar
# repair plans preview-first, pedir permissao contextual e sugerir fallback
# explicito. Reparo/retomada continuam governados por approval e ExecutionGateway.
ZAVORTH_CAPABILITY_AUTOPILOT=false

# === Telegram ===
# Canal opcional. Crie um bot via @BotFather no Telegram e cole o token aqui.
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
# IDs dos usuários autorizados (separados por vírgula se mais de um).
TELEGRAM_ALLOWED_USER_IDS=SEU_ID_AQUI
# Mapeamento opcional de roles por usuario:
# TELEGRAM_USER_ROLES=123:admin|operator;456:viewer
# Se omitido, todos os usuarios autorizados sao tratados como admin.
# TELEGRAM_USER_ROLES=
# URL publica opcional do dashboard web, se voce expuser o painel por tunnel ou reverse proxy.
# Exemplo: https://zavorth.seu-dominio.com
# ZAVORTH_PUBLIC_BASE_URL=
# Se voce usar Cloudflare Tunnel, o Zavorth tambem consegue derivar a URL publica daqui.
# Exemplo: zavorth.seu-dominio.com
# CLOUDFLARE_TUNNEL_PUBLIC_HOSTNAME=
# Multicanal: Discord.
# Canal opcional. O wizard `npm run setup:channels` ja deixa o scaffold correto pronto.
# Se DISCORD_BOT_TOKEN existir, o runtime prefere o gateway nativo.
# Sem token nativo, voce ainda pode operar pelo fallback relay/bridge local.
# Token do bot do Discord para subir o gateway nativo.
# DISCORD_BOT_TOKEN=
# Guilds/servidores permitidos para o canal do Discord.
# DISCORD_ALLOWED_GUILD_IDS=
# Canais permitidos dentro das guilds. Recomendado para servidores cheios ou rollout gradual.
# Aceita canais normais e canais-pai de threads.
# DISCORD_ALLOWED_CHANNEL_IDS=
# Endurece o Discord para servidor cheio: sem allowlist por canal, o runtime nao aceita trafego de guild.
# Tambem muda o default de exposicao para minimal.
# DISCORD_PUBLIC_SERVER_MODE=true
# Permite DMs no Discord. Se false, so guilds allowlisted entram.
# DISCORD_ALLOW_DMS=false
# Politica de exposicao no Discord: none|minimal|operator.
# none = nao registra slash commands; minimal = so task/plan/auto/help; operator = inclui comandos operacionais.
# Para servidor cheio, prefira minimal e mantenha operacao no Telegram ou em usuarios operadores.
# DISCORD_COMMAND_EXPOSURE=minimal
# IDs dos owners reais do Discord. Em servidor publico, eles sao a referencia principal para operacao sensivel.
# DISCORD_OWNER_USER_IDS=
# Se true, comandos operacionais no Discord ficam owner-only por padrao.
# Em servidor publico, o Zavorth ainda exige DM do owner para evitar vazamento em canal.
# DISCORD_REQUIRE_OWNER_FOR_OPERATIONAL=true
# IDs de usuarios do Discord autorizados a usar comandos operacionais quando a exposicao for operator.
# DISCORD_OPERATOR_USER_IDS=
# Guardrails basicos para Discord publico.
# Bloqueia @everyone e @here por padrao.
# DISCORD_BLOCK_MASS_MENTIONS=true
# Limite simples de links por mensagem em canais publicos.
# DISCORD_MAX_LINKS_PER_MESSAGE=3
# Mantem anexos bloqueados por padrao em servidor publico para reduzir abuso e prompt injection.
# DISCORD_ALLOW_ATTACHMENTS_IN_PUBLIC_SERVER_MODE=false
# Teto defensivo de caracteres por mensagem no Discord.
# DISCORD_MAX_MESSAGE_CHARS=1800
# Rate limit simples por usuario para reduzir flood/bruteforce no Discord.
# DISCORD_RATE_LIMIT_WINDOW_MS=60000
# DISCORD_RATE_LIMIT_MAX_REQUESTS=6
# Se true, falha o boot quando o Discord for obrigatorio e nao subir corretamente.
# DISCORD_REQUIRED_ON_BOOT=false
# Alias unico legado para um servidor/guild principal.
# DISCORD_GUILD_ID=
# Fallback local relay/bridge do Discord. So use se voce estiver operando o relay local.
# DISCORD_BRIDGE_ENABLED=false
# DISCORD_BRIDGE_SECRET=
# DISCORD_BRIDGE_SECRET_FILE=
# DISCORD_BRIDGE_ALLOW_DMS=false
# Preparacao multiplataforma: WhatsApp.
# Canal opcional. O wizard `npm run setup:channels` ja deixa pronto o modo stub, cloud-api ou baileys.
# Habilita o canal WhatsApp. Com provider cloud-api, o Zavorth usa webhook e outbound reais.
# WHATSAPP_ENABLED=false
# Decide o provider-alvo do WhatsApp: stub, cloud-api ou baileys.
# WHATSAPP_PROVIDER=stub
# Versao da Cloud API do WhatsApp quando WHATSAPP_PROVIDER=cloud-api.
# WHATSAPP_CLOUD_API_VERSION=v20.0
# Phone number id da Cloud API do WhatsApp.
# WHATSAPP_PHONE_NUMBER_ID=
# Access token da Cloud API do WhatsApp.
# WHATSAPP_ACCESS_TOKEN=
# Webhook verify token da Cloud API do WhatsApp.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Token placeholder legado para futuras integracoes baseadas em API oficial.
# WHATSAPP_BOT_TOKEN=
# Chats/grupos permitidos para broadcast operacional.
# WHATSAPP_ALLOWED_CHAT_IDS=
# Diretorio de sessao previsto para uma futura integracao persistente.
# WHATSAPP_SESSION_DIR=
# Outbox local usado pelo stub/bridge do WhatsApp para testes operacionais do Channel Mesh.
# WHATSAPP_OUTBOX_DIR=
# Snapshot de status do runtime local do WhatsApp.
# WHATSAPP_STATUS_FILE=
# Preparacao multiplataforma: Slack.
# Canal opcional. O wizard `npm run setup:channels` ja deixa pronto o modo stub ou native.
# Habilita o canal Slack em modo stub/preparacao para o Channel Mesh.
# SLACK_ENABLED=false
# Modo de transporte do Slack: auto, stub ou native.
# SLACK_TRANSPORT=auto
# Token do bot do Slack. Quando presente, o Zavorth pode iniciar outbound real via chat.postMessage.
# SLACK_BOT_TOKEN=
# Signing secret do Slack para validar webhooks nativos.
# SLACK_SIGNING_SECRET=
# Base URL da Slack Web API para o modo native.
# SLACK_API_BASE_URL=https://slack.com/api
# Workspace do Slack associado ao stub local.
# SLACK_WORKSPACE_ID=
# Canais permitidos para testes de broadcast no mesh.
# SLACK_ALLOWED_CHANNEL_IDS=
# Outbox local usado pelo stub/bridge do Slack para testes operacionais do Channel Mesh.
# SLACK_OUTBOX_DIR=
# Snapshot de status do runtime local do Slack.
# SLACK_STATUS_FILE=

# Preparacao multiplataforma: Signal.
# Bridge local via signal-cli/JSON-RPC. Use uma conta dedicada e allowlist fechada.
# SIGNAL_ENABLED=false
# SIGNAL_TRANSPORT=signal-cli
# SIGNAL_CLI_PATH=signal-cli
# SIGNAL_JSONRPC_URL=
# SIGNAL_ACCOUNT_NUMBER=
# SIGNAL_ALLOWED_RECIPIENTS=
# SIGNAL_OUTBOX_DIR=
# SIGNAL_STATUS_FILE=

# Preparacao multiplataforma: iMessage.
# Bridge experimental via macOS Node Host. Comece em modo read-only.
# IMESSAGE_ENABLED=false
# IMESSAGE_BRIDGE_MODE=mac-bridge
# IMESSAGE_NODE_ID=
# IMESSAGE_BRIDGE_SCRIPT=
# IMESSAGE_ALLOWED_RECIPIENTS=
# IMESSAGE_READ_ONLY=true
# IMESSAGE_OUTBOX_DIR=
# IMESSAGE_STATUS_FILE=

# Preparacao multiplataforma: Microsoft Teams.
# Canal corporativo planejado via Graph/Bot Framework.
# TEAMS_ENABLED=false
# TEAMS_TRANSPORT=graph-bot
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# TEAMS_CLIENT_SECRET=
# TEAMS_TENANT_ID=
# TEAMS_ALLOWED_CONVERSATION_IDS=
# TEAMS_STATUS_FILE=

# Preparacao multiplataforma: Email.
# Fallback universal para notificacoes e approvals via SMTP/IMAP.
# EMAIL_ENABLED=false
# EMAIL_TRANSPORT=smtp-imap
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_IMAP_HOST=
# EMAIL_ALLOWED_RECIPIENTS=
# EMAIL_OUTBOX_DIR=
# EMAIL_STATUS_FILE=

# Host e porta do dashboard web local.
# ZAVORTH_WEB_HOST=127.0.0.1
# ZAVORTH_WEB_PORT=3000
# ZAVORTH_BACKEND_URL=http://localhost:3000
# ZAVORTH_DASHBOARD_URL=http://localhost:5173
# ZAVORTH_AGENT_WAKE_WORD=zavorth
# ZAVORTH_AGENT_HOTKEY=B
# ZAVORTH_AGENT_LANGUAGE=pt
# ZAVORTH_AGENT_TTS_VOICE=pt-BR-AntonioNeural
# ZAVORTH_EXTERNAL_WEB_CLIENT_URL=
# ZAVORTH_EXTERNAL_DOCS_URL=

# Casa inteligente opcional. Deixe vazio se o usuario nao usa Home Assistant.
# HOME_ASSISTANT_URL=http://192.168.1.50:8123
# HOME_ASSISTANT_TOKEN=

# Perfil operacional do Zavorth:
# core = leve por padrao | ops = adiciona manutencao e relatorio | full = preaquece tudo
# ZAVORTH_PROFILE=core
# Politica atual de capabilities pesadas sob demanda.
# ZAVORTH_CAPABILITY_POLICY=ask-on-demand
# Politica atual de selfmod.
# ZAVORTH_SELFMOD_POLICY=owner_trusted
# Diretorio base da mailbox por arquivos do motor autonomo.
# Se omitido, usa `data/agent-bridge/mailbox`.
# ZAVORTH_MAILBOX_DIR=
# Subpastas opcionais se voce quiser separar inbox/processados/rejeitados/runtime manualmente.
# ZAVORTH_MAILBOX_INBOX_DIR=
# ZAVORTH_MAILBOX_PROCESSED_DIR=
# ZAVORTH_MAILBOX_REJECTED_DIR=
# ZAVORTH_MAILBOX_RUNTIME_DIR=
# ZAVORTH_MAILBOX_SEEN_DIR=
# Segredo opcional para assinar a mailbox local do motor autonomo.
# Se omitido, o Zavorth gera e persiste uma chave local em `data/runtime/mailbox-secret.key`.
# ZAVORTH_MAILBOX_SECRET=
# Permite aceitar payloads antigos sem assinatura durante migracao local. Mantenha `false` por padrao.
# ZAVORTH_ALLOW_LEGACY_MAILBOX=false
# Caminho legado do mailbox em arquivo unico.
# So use se voce estiver importando uma integracao antiga durante a migracao.
# ZAVORTH_MAILBOX_PATH=

# === LLM Provider ===
# Opcoes: gemini, deepseek, openai, minimax, qwen, openrouter, aigateway, opencode
LLM_PROVIDER=gemini

# === Nexus / Ollama local ===
# O Nexus usa Ollama local por padrao. O servidor pode ficar leve, e o modelo
# descarrega automaticamente da RAM depois do periodo em OLLAMA_KEEP_ALIVE.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma2:2b
# Use 30s para manter o modelo quente por pouco tempo; use 0 para descarregar logo apos cada resposta.
OLLAMA_KEEP_ALIVE=30s
OLLAMA_AUTO_START=true
OLLAMA_START_TIMEOUT_MS=15000

# === API Keys ===
# Chave principal do Google Gemini (obrigatória para o provider padrão)
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI
# Opcional: roteia Gemini/Gemma por Cloudflare AI Gateway para ganhar analytics,
# cache, rate limiting e observabilidade da borda.
# CLOUDFLARE_AI_GATEWAY_ACCOUNT_ID=
# CLOUDFLARE_AI_GATEWAY_ID=
# Token opcional de protecao do gateway.
# CLOUDFLARE_AI_GATEWAY_TOKEN=
# Alternativa generica para qualquer proxy/endpoint compativel com Gemini:
# GEMINI_API_BASE_URL=
# GEMINI_API_VERSION=v1beta
# GEMINI_CUSTOM_HEADERS_JSON={"x-seu-header":"valor"}
# Chave opcional dedicada ao executor /aistudio. Se omitida, reutiliza GEMINI_API_KEY.
# AISTUDIO_API_KEY=
# Chaves secundárias para failover (opcionais)
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# Chave separada para transcrição de áudio/vídeo
# GEMINI_TRANSCRIPTION_API_KEY=
# Providers alternativos (opcionais)
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENCODE_API_KEY=
# Google Stitch (opcional, mas necessario para /stitch)
# STITCH_API_KEY=
# Alternativa OAuth:
# STITCH_ACCESS_TOKEN=

# === Sandbox Docker Forte ===
# Ativa o runtime endurecido por container.
# ZAVORTH_DOCKER_SANDBOX_ENABLED=true
# Se true, o smoke trata a indisponibilidade do container forte como falha bloqueante.
# ZAVORTH_DOCKER_SANDBOX_REQUIRED=false
# Se true, o Zavorth tenta baixar imagens ausentes na primeira execucao.
# ZAVORTH_DOCKER_SANDBOX_AUTO_PULL=false
# CLI do Docker no host.
# DOCKER_CLI_PATH=docker
# No Windows com WSL, voce pode apontar para o wrapper local do repo:
# DOCKER_CLI_PATH=C:\workspace\zavorth\scripts\docker-wsl-zavorth.cmd
# Imagem legado/default para compatibilidade.
# ZAVORTH_DOCKER_SANDBOX_IMAGE=node:22-bullseye
# Imagem usada para Javascript/Node.
# ZAVORTH_DOCKER_SANDBOX_JAVASCRIPT_IMAGE=node:22-bullseye
# Imagem usada para Python.
# ZAVORTH_DOCKER_SANDBOX_PYTHON_IMAGE=python:3.12-slim
# Imagem usada para Shell puro.
# ZAVORTH_DOCKER_SANDBOX_SHELL_IMAGE=bash:5.2
# Timeout do probe do daemon Docker.
# ZAVORTH_DOCKER_SANDBOX_PROBE_TIMEOUT_MS=5000
# Timeout maximo para pull de imagem.
# ZAVORTH_DOCKER_SANDBOX_PULL_TIMEOUT_MS=120000
# Limites do container.
# ZAVORTH_DOCKER_SANDBOX_MEMORY_MB=1024
# ZAVORTH_DOCKER_SANDBOX_CPU_LIMIT=1.5
# ZAVORTH_DOCKER_SANDBOX_WORKSPACE_PATH=/workspace
# Runtime de seguranca do Docker. Use 'runsc' para gVisor (recomendado em producao Linux).
# Deixe vazio para usar o runtime padrao (runc) em desenvolvimento local.
# ZAVORTH_DOCKER_SANDBOX_RUNTIME=runsc
# Hardening flags (todos habilitados por padrao em producao):
# ZAVORTH_DOCKER_SANDBOX_PIDS_LIMIT=64
# ZAVORTH_DOCKER_SANDBOX_READ_ONLY=true
# ZAVORTH_DOCKER_SANDBOX_CAP_DROP_ALL=true
# ZAVORTH_DOCKER_SANDBOX_NO_NEW_PRIVILEGES=true

# === Firecracker MicroVM (Isolamento Maximo) ===
# Ativa o runtime de MicroVM Firecracker para execucao de codigo de alto risco.
# Requer Linux com KVM habilitado (/dev/kvm acessivel).
# ZAVORTH_FIRECRACKER_ENABLED=false
# No Windows, o Zavorth pode usar o Firecracker do WSL em vez de exigir que o
# proprio processo principal rode em Linux.
# ZAVORTH_FIRECRACKER_TRANSPORT=wsl
# ZAVORTH_FIRECRACKER_WSL_DISTRO=Ubuntu-24.04
# ZAVORTH_FIRECRACKER_WSL_USER=root
# Desliga a ponte WSL apos um periodo de inatividade para nao deixar processo solto.
# ZAVORTH_FIRECRACKER_WSL_BRIDGE_IDLE_MS=300000
# Caminho do binario do Firecracker. Baixe em github.com/firecracker-microvm/firecracker/releases.
# ZAVORTH_FIRECRACKER_BIN_PATH=firecracker
# Caminho do kernel vmlinux para boot das MicroVMs.
# ZAVORTH_FIRECRACKER_KERNEL_PATH=data/firecracker/vmlinux
# Caminho do rootfs ext4. Deve conter node, python3 e bash pre-instalados.
# ZAVORTH_FIRECRACKER_ROOTFS_PATH=data/firecracker/rootfs.ext4
# Recursos alocados por MicroVM:
# ZAVORTH_FIRECRACKER_VCPU_COUNT=1
# ZAVORTH_FIRECRACKER_MEM_SIZE_MIB=512
# Timeout maximo de execucao em uma MicroVM.
# ZAVORTH_FIRECRACKER_EXECUTION_TIMEOUT_MS=30000

# GOOGLE_CLOUD_PROJECT=
# STITCH_HOST=https://stitch.googleapis.com/mcp

# === Agent Loop ===
MAX_ITERATIONS=5

# === Memory ===
MEMORY_WINDOW_SIZE=20
MAX_TOKENS=8000

# === Video Processing ===
VIDEO_CHUNK_CONCURRENCY=2
VIDEO_CONTEXT_RETENTION_DAYS=30
VIDEO_CONTEXT_MAX_FILES=120
TEMP_FILE_RETENTION_HOURS=2

# === Modelos ===
GEMINI_MODEL=gemini-2.5-flash
# Alias opcional para usar Gemma 4 via Gemini API hospedada pela Google.
# Exemplo oficial atual: gemma-4-31b-it
GEMMA_MODEL=gemma-4-31b-it
# Modelo padrao do /aistudio (aceita override inline: /aistudio model=gemini-2.5-pro ...)
# AISTUDIO_MODEL=gemini-2.5-flash
# Permite que o /aistudio abra pedidos de aprovacao quando o modelo solicitar servicos externos.
# AISTUDIO_ALLOW_SERVICE_REQUESTS=true
# Numero maximo de rodadas de tools/function-calling por execucao.
# AISTUDIO_MAX_TOOL_ROUNDS=4
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini
AIGateway_MODEL=gpt-4o-mini
# URL anunciada ao runtime do Zavorth. Quando o gateway proprio estiver ativo,
# este valor aponta para a rota estavel do Zavorth em vez do upstream cru.
AIGateway_BASE_URL=http://127.0.0.1:21128/v1
# URL do upstream real do AIGateway sidecar/vendor, quando usado.
# AIGateway_UPSTREAM_BASE_URL=http://127.0.0.1:20128/v1
AIGateway_SIDECAR_ENABLED=false
AIGateway_SIDECAR_INSTALL_ON_BOOT=true
AIGateway_SIDECAR_READY_TIMEOUT_MS=300000
# Gateway proprio do Zavorth na frente do upstream AIGateway.
# ZAVORTH_AIGateway_GATEWAY_ENABLED=true
# ZAVORTH_AIGateway_GATEWAY_HOST=127.0.0.1
# ZAVORTH_AIGateway_GATEWAY_PORT=21128
# ZAVORTH_AIGateway_GATEWAY_BASE_URL=http://127.0.0.1:21128/v1
# ZAVORTH_AIGateway_GATEWAY_READY_TIMEOUT_MS=10000
# ZAVORTH_AIGateway_GATEWAY_STATUS_FILE=
# ZAVORTH_AIGateway_GATEWAY_ENTRYPOINT_FILE=
# ZAVORTH_AIGateway_SYNC_STATUS_FILE=
# ZAVORTH_AIGateway_COMPAT_STATUS_FILE=
# ZAVORTH_AIGateway_OVERLAY_FILE=
MINIMAX_MODEL=MiniMax-M2.7
QWEN_MODEL=openrouter:qwen/qwen3.5-plus-02-15
OPENROUTER_MODEL=minimax/minimax-m2.7
OPENCODE_MODEL=opencode/minimax-m2.5-free
# Modelo/dispositivo padrao do Stitch (opcionais)
# STITCH_DEFAULT_DEVICE_TYPE=AGNOSTIC
# STITCH_DEFAULT_MODEL_ID=GEMINI_3_FLASH
# STITCH_TIMEOUT_SECONDS=240

# === Zavorth Bridge Remote ===
# Habilita o sidecar remoto do ZavorthBridge junto com o Zavorth.
ZAVORTH_BRIDGE_AUTOMATION_ENABLED=true
ZAVORTH_BRIDGE_REMOTE_DEBUGGING_PORT=7800
# Workspace que sera aberta no ZavorthBridge quando voce usar `npm run zavorthBridge:start` ou `npm run start:all`.
# ZAVORTH_BRIDGE_START_WORKSPACE=
# Espera em milissegundos antes de subir o Zavorth depois de abrir o ZavorthBridge.
ZAVORTH_BRIDGE_START_DELAY_MS=4000
ZAVORTH_BRIDGE_REMOTE_BASE_URL=http://127.0.0.1:4747
# URL publica opcional do remoto do ZavorthBridge para uso fora da rede local.
# Exemplo: https://ag.seu-dominio.com
# ZAVORTH_BRIDGE_REMOTE_PUBLIC_URL=
# Se true, o Zavorth tenta abrir um Quick Tunnel via cloudflared quando o remoto estiver pronto
# e nenhuma URL publica explicita estiver configurada.
# ZAVORTH_ZAVORTH_BRIDGE_PUBLIC_TUNNEL_ENABLED=true
# Caminho do binario do cloudflared usado no Quick Tunnel automatico.
# ZAVORTH_ZAVORTH_BRIDGE_PUBLIC_TUNNEL_CLI_PATH=cloudflared
# Timeout para esperar a URL publica aparecer.
# ZAVORTH_ZAVORTH_BRIDGE_PUBLIC_TUNNEL_READY_TIMEOUT_MS=15000
# Arquivos de estado/log do tunnel automatico.
# ZAVORTH_ZAVORTH_BRIDGE_PUBLIC_TUNNEL_STATE_FILE=
# ZAVORTH_ZAVORTH_BRIDGE_PUBLIC_TUNNEL_LOG_FILE=
ZAVORTH_BRIDGE_REMOTE_SIDECAR_ENABLED=true
ZAVORTH_BRIDGE_REMOTE_SIDECAR_INSTALL_ON_BOOT=true
ZAVORTH_BRIDGE_REMOTE_SIDECAR_READY_TIMEOUT_MS=180000
# Senha do app remoto. Se omitida, o Zavorth reutiliza ZAVORTH_WEB_AUTH_TOKEN.
# ZAVORTH_BRIDGE_REMOTE_APP_PASSWORD=
# TTL padrao do acesso movel sob demanda do ZavorthBridge.
# ZAVORTH_ZAVORTH_BRIDGE_MOBILE_LEASE_TTL_MS=7200000
# Arquivos de estado do lease movel do ZavorthBridge.
# ZAVORTH_ZAVORTH_BRIDGE_MOBILE_LEASE_FILE=
# ZAVORTH_ZAVORTH_BRIDGE_MOBILE_LEASE_HISTORY_FILE=

# === Node Mesh ===
# Arquivos de estado do mesh, segredos e fila persistida de invocacoes.
# ZAVORTH_NODE_MESH_STATE_FILE=
# ZAVORTH_NODE_MESH_SECRETS_FILE=
# ZAVORTH_NODE_MESH_INVOCATION_FILE=
# Intervalo sugerido do heartbeat remoto para node hosts headless.
ZAVORTH_NODE_MESH_HEARTBEAT_INTERVAL_MS=15000
# Janela maxima para considerar o ultimo node mesh smoke ainda valido.
ZAVORTH_NODE_MESH_SMOKE_MAX_AGE_MS=43200000
# Arquivo persistido do doctor operacional de Slack native / WhatsApp Cloud API.
# ZAVORTH_CHANNEL_PROVIDER_DOCTOR_REPORT_FILE=
# Janela maxima para considerar o doctor dos canais nativos ainda fresco.
ZAVORTH_CHANNEL_PROVIDER_DOCTOR_MAX_AGE_MS=43200000
# Arquivo persistido do doctor de transportes remotos.
# ZAVORTH_REMOTE_TRANSPORT_DOCTOR_REPORT_FILE=
# Janela maxima para considerar o doctor dos transportes remotos ainda fresco.
ZAVORTH_REMOTE_TRANSPORT_DOCTOR_MAX_AGE_MS=43200000
# Catalogo local que ancora discovery de plugins, skills e MCPs no platform plane.
# ZAVORTH_PLATFORM_REGISTRY_CATALOG_FILE=
# URL HTTPS opcional de um registry remoto para plugins, skills, MCPs, colecoes e recipes.
# ZAVORTH_PLATFORM_REGISTRY_REMOTE_URL=
# Token opcional para autenticar o fetch do registry remoto.
# ZAVORTH_PLATFORM_REGISTRY_REMOTE_TOKEN=
# Allowlist opcional de hosts permitidos para o catalogo remoto.
# ZAVORTH_PLATFORM_REGISTRY_REMOTE_ALLOWED_HOSTS=registry.example.com
# Hosts HTTP explicitamente liberados para desenvolvimento local controlado.
# ZAVORTH_PLATFORM_REGISTRY_REMOTE_ALLOW_HTTP_HOSTS=127.0.0.1,localhost
# SHA-256 esperado do snapshot remoto quando quiser pinning de integridade.
# ZAVORTH_PLATFORM_REGISTRY_REMOTE_EXPECTED_SHA256=
# Cache local do snapshot remoto do registry.
# ZAVORTH_PLATFORM_REGISTRY_REMOTE_CACHE_FILE=
# Status persistido do ultimo sync do registry remoto.
# ZAVORTH_PLATFORM_REGISTRY_REMOTE_STATUS_FILE=
# Janela maxima de frescor do cache remoto antes de virar stale.
# ZAVORTH_PLATFORM_REGISTRY_REMOTE_MAX_AGE_MS=43200000
# Timeout do fetch remoto do registry em milissegundos.
# ZAVORTH_PLATFORM_REGISTRY_REMOTE_SYNC_TIMEOUT_MS=8000
# Policy local do Channel Mesh.
# ZAVORTH_CHANNEL_POLICY_SLACK_OPEN=false
# ZAVORTH_CHANNEL_POLICY_SLACK_ALLOWED=
# ZAVORTH_CHANNEL_POLICY_SLACK_BLOCKED=spammer@corp.com
# ZAVORTH_CHANNEL_POLICY_WHATSAPP_ALLOWED=+5511999999999
# ZAVORTH_CHANNEL_POLICY_WHATSAPP_BLOCKED=
# ZAVORTH_CHANNEL_POLICY_TELEGRAM_OPEN=false
# ZAVORTH_CHANNEL_POLICY_TELEGRAM_ALLOWED=
# ZAVORTH_CHANNEL_POLICY_TELEGRAM_BLOCKED=
# ZAVORTH_CHANNEL_POLICY_DISCORD_OPEN=false
# ZAVORTH_CHANNEL_POLICY_DISCORD_ALLOWED=
# ZAVORTH_CHANNEL_POLICY_DISCORD_BLOCKED=
# ZAVORTH_CHANNEL_POLICY_SIGNAL_OPEN=false
# ZAVORTH_CHANNEL_POLICY_SIGNAL_ALLOWED=
# ZAVORTH_CHANNEL_POLICY_SIGNAL_BLOCKED=
# ZAVORTH_CHANNEL_POLICY_IMESSAGE_OPEN=false
# ZAVORTH_CHANNEL_POLICY_IMESSAGE_ALLOWED=
# ZAVORTH_CHANNEL_POLICY_IMESSAGE_BLOCKED=
# ZAVORTH_CHANNEL_POLICY_TEAMS_OPEN=false
# ZAVORTH_CHANNEL_POLICY_TEAMS_ALLOWED=
# ZAVORTH_CHANNEL_POLICY_TEAMS_BLOCKED=
# ZAVORTH_CHANNEL_POLICY_EMAIL_OPEN=false
# ZAVORTH_CHANNEL_POLICY_EMAIL_ALLOWED=
# ZAVORTH_CHANNEL_POLICY_EMAIL_BLOCKED=

# === External Executor ===
EXTERNAL_EXECUTOR_CLI_PATH=C:/Windows/System32/wsl.exe
EXTERNAL_EXECUTOR_TRANSPORT=wsl
EXTERNAL_EXECUTOR_COMMAND=external-executor
EXTERNAL_EXECUTOR_AGENT_ID=main
EXTERNAL_EXECUTOR_THINKING=low
EXTERNAL_EXECUTOR_WSL_DISTRO=Ubuntu
EXTERNAL_EXECUTOR_WSL_USER=
EXTERNAL_EXECUTOR_TIMEOUT_SECONDS=240

# === Mnemos Cognitive Engine (Motor de Memória) ===
# Subsistema de memória vetorial local. Roda como servidor MCP em container Docker isolado.
# O Zavorth se conecta automaticamente via manifesto MCP (config/mcp-servers.json).
# Diretório local do cofre principal de documentos do Mnemos (montado como volume no Docker).
# Este é o diretório que você pode jogar PDFs, anotações, códigos para indexação automática.
# MNEMOS_VAULT_DIR=C:\Mnemos_Vault
# Diretórios que o Mnemos pode varrer em busca de arquivos por nome (READ-ONLY no container).
# Separe múltiplos diretórios com ; no Windows. Ex: %USERPROFILE%\Downloads;%USERPROFILE%\Documents
# MNEMOS_SCAN_DIRS=
# Diretório de persistência do banco vetorial ChromaDB (persiste entre reinicializações do container).
# MNEMOS_DB_DIR=
# Modelo de embedding local usado pelo Sentence Transformers.
# Modelos recomendados para 8GB RAM: all-MiniLM-L6-v2 (rápido), paraphrase-multilingual-MiniLM-L12-v2 (multilingual)
# MNEMOS_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Profundidade máxima de varredura nos diretórios de scan.
# MNEMOS_MAX_SCAN_DEPTH=5
# Quantidade máxima de resultados retornados por busca.
# MNEMOS_MAX_RESULTS=10
